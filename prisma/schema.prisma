generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  nameEn         String?
  nameUk         String?
  /// Public booking URL segment for masseurs, e.g. "olena-kyiv". Unique when set.
  slug           String?   @unique
  email          String
  emailVerified  DateTime?
  /// E.164 phone for client credentials auth; required and public for masseurs (BR-004).
  phone          String?
  image          String?
  descriptionEn  String?
  descriptionUk  String?
  massageTypes   String    @default("[]")
  /// Legacy free-text city; kept for rows without canonical place data.
  city           String?
  /// Nominatim place_id (canonical city key for clients and masseurs).
  cityPlaceId    String?
  cityCountryCode String?
  cityNameEn     String?
  cityNameUk     String?
  cityLat        Float?
  cityLon        Float?
  address        String?
  /// IANA time zone of a masseur (slots, working hours and "today" are
  /// evaluated in it). Unused for clients. Keep the default in sync with
  /// DEFAULT_MASSEUR_TIME_ZONE in src/lib/booking-constants.ts.
  timezone       String    @default("Europe/Kyiv")
  /// UI + notification language (`en` | `uk`).
  preferredLocale String   @default("en")
  /// Client booking lead time in hours (1/2/3/4). Masseur-only (BR-002).
  bookingLeadHours   Int       @default(1)
  /// Client cancellation cutoff in hours; never below bookingLeadHours (BR-004).
  cancelCutoffHours  Int       @default(24)
  /// Hours before slotStart to remind the client; null = Off (BR-009 reminder).
  reminderHours      Int?      @default(24)
  emailVerifyLastSentAt      DateTime?
  emailVerifySendWindowStart DateTime?
  emailVerifySendCount       Int       @default(0)
  passwordHash   String?
  /// Bumped on password reset/change; JWT `pwdChangedAt` must match or be older (#79).
  passwordChangedAt DateTime?
  /// Separate identity per portal: "masseur" | "client". Same email may exist once each.
  portal         String
  /// Telegram chat id for optional BR-009 notifications (same chat may link client+masseur when email/phone match).
  telegramChatId String?
  telegramLinkedAt DateTime?
  /// Set when the app/bot asks this portal user to share contact for BR-023.
  telegramAwaitingPhoneConfirm Boolean @default(false)
  /// Optional phone confirmation via Telegram contact share (BR-023).
  phoneConfirmedAt DateTime?
  /// Set when the account is self-deleted and anonymised (BR-011).
  deletedAt      DateTime?
  /// Set when an administrator blocks the account (BR-021).
  blockedAt      DateTime?
  accounts       Account[]
  sessions       Session[]
  masseurBookings Booking[] @relation("MasseurBookings")
  clientBookings  Booking[] @relation("ClientBookings")
  availabilitySlots AvailabilitySlot[]
  galleryImages  GalleryImage[]
  notificationPreferences NotificationPreference[]
  notificationOutbox      NotificationOutbox[]
  inAppNotifications      InAppNotification[]
  adminAuditLogsAsActor AdminAuditLog[] @relation("AdminAuditActor")
  complaintsFiled    Complaint[] @relation("ComplaintReporter")
  complaintsReceived Complaint[] @relation("ComplaintTarget")
  complaintsResolved Complaint[] @relation("ComplaintResolver")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([email, portal])
  @@unique([phone, portal])
  @@index([portal])
  @@index([telegramChatId])
  @@index([deletedAt])
  @@index([blockedAt])
}

/// Administrator action log (BR-021 / XR-1).
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String
  targetUserId String?
  metaJson     String?
  createdAt    DateTime @default(now())

  actor User @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Same Google account may link to both a masseur and a client user.
  @@unique([provider, providerAccountId, userId])
  @@index([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Sliding-window counter for BR-020 rate limits (Postgres-backed for serverless).
model RateLimitBucket {
  id          String   @id @default(cuid())
  /// Opaque `scope:sha256(subject)` — never raw phone/email/IP (#81).
  key         String   @unique
  windowStart DateTime
  count       Int
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// The exclusion constraint "Booking_no_overlapping_active_slots" (SQL only)
/// treats every status except `cancelled` as occupying the hour. Review it
/// whenever a value is added here.
enum BookingStatus {
  confirmed
  cancelled
}

enum CancelledBy {
  client
  masseur
}

enum CancellationReason {
  cant_make_it
  circumstances_changed
  changed_mind
  wrong_slot
  other
  /// System reason, set when a client deletes their account.
  client_account_deleted
}

model Booking {
  id               String              @id @default(cuid())
  masseurId        String
  /// Client account that owns this booking; null for masseur walk-in bookings.
  clientUserId     String?
  clientName       String
  clientPhone      String
  slotStart        DateTime?
  massageType      String?
  note             String?
  status           BookingStatus       @default(confirmed)
  cancelledBy      CancelledBy?
  cancelledAt      DateTime?
  cancelReason     CancellationReason?
  /// Free text, only for `cancelReason = other`.
  cancelReasonText String?             @db.VarChar(200)
  /// When true, cleanup cron must not hard-delete (payments/disputes — BR-011/018).
  hasRetentionHold Boolean             @default(false)
  /// Set when a booking_reminder was claimed/enqueued (BR-009).
  reminderSentAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  masseur User  @relation("MasseurBookings", fields: [masseurId], references: [id], onDelete: Cascade)
  client  User? @relation("ClientBookings", fields: [clientUserId], references: [id], onDelete: SetNull)
  notificationOutbox NotificationOutbox[]
  inAppNotifications InAppNotification[]
  complaints         Complaint[]

  @@index([masseurId])
  @@index([masseurId, slotStart])
  @@index([clientUserId])
  @@index([clientUserId, status])
  @@index([clientUserId, slotStart])
  @@index([status, cancelledAt])
  @@index([status, slotStart])
  @@index([hasRetentionHold])
}

/// User-to-user complaint for admin review (BR-021).
enum ComplaintCategory {
  no_show
  rude
  spam
  other
}

enum ComplaintStatus {
  open
  resolved
  dismissed
}

model Complaint {
  id           String            @id @default(cuid())
  reporterId   String
  targetId     String
  bookingId    String?
  category     ComplaintCategory
  body         String            @db.VarChar(500)
  status       ComplaintStatus   @default(open)
  /// Internal admin note; never shown to reporter or target.
  adminNote    String?           @db.VarChar(1000)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  reporter   User     @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User     @relation("ComplaintTarget", fields: [targetId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resolvedBy User?    @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetId])
  @@index([bookingId])
}

enum NotificationEventType {
  booking_created
  booking_cancelled_by_client
  booking_cancelled_by_masseur
  booking_cancelled_client_deleted
  booking_confirmed
  booking_reminder
}

enum NotificationChannel {
  email
  telegram
}

enum NotificationOutboxStatus {
  pending
  processing
  sent
  failed
  dead
}

/// Per-user, per-event channel preferences (BR-009).
model NotificationPreference {
  id              String                @id @default(cuid())
  userId          String
  eventType       NotificationEventType
  emailEnabled    Boolean               @default(true)
  telegramEnabled Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@index([userId])
}

/// Delivery log + retry queue for BR-009 (XR-1: no phones in payload).
model NotificationOutbox {
  id            String                    @id @default(cuid())
  userId        String
  bookingId     String?
  eventType     NotificationEventType
  channel       NotificationChannel       @default(email)
  status        NotificationOutboxStatus  @default(pending)
  attemptCount  Int                       @default(0)
  nextAttemptAt DateTime?
  /// Exclusive delivery lease (#80); reclaim when expired while `processing`.
  leaseExpiresAt DateTime?
  lastError     String?                   @db.VarChar(500)
  /// Minimal render snapshot (names, slot ISO, massage type, reason, locale, path).
  payloadJson   String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  sentAt        DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([status, sentAt])
  @@index([status, updatedAt])
  @@index([userId, createdAt])
  @@index([bookingId])
}

/// In-app inbox for client/masseur (BR-009); not a delivery queue.
model InAppNotification {
  id        String                @id @default(cuid())
  userId    String
  bookingId String?
  eventType NotificationEventType
  title     String                @db.VarChar(200)
  body      String                @db.VarChar(1000)
  href      String                @db.VarChar(200)
  readAt    DateTime?
  createdAt DateTime              @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
  @@index([bookingId])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  masseurId String
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masseur User @relation(fields: [masseurId], references: [id], onDelete: Cascade)

  @@unique([masseurId, start])
  @@index([masseurId, start])
}

model GalleryImage {
  id        String   @id @default(cuid())
  masseurId String
  url       String
  width     Int
  height    Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  masseur User @relation(fields: [masseurId], references: [id], onDelete: Cascade)

  @@index([masseurId, sortOrder])
}
