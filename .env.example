# Database — PostgreSQL (required for Vercel; use local Docker or Neon/Supabase)
# Local Docker (see docker-compose.yml):
DATABASE_URL="postgresql://massage:massage@localhost:5432/massage?schema=public"
# Neon / Vercel Postgres example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="dev-secret-change-me-in-production"

# App URL (used by Auth.js for callbacks)
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URIs (exact match required):
#   http://localhost:3000/api/auth/masseur/callback/google
#   http://localhost:3000/api/auth/client/callback/google
#   https://YOUR_DOMAIN/api/auth/masseur/callback/google
#   https://YOUR_DOMAIN/api/auth/client/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel Blob — required on Vercel so photo uploads persist.
# Create in Vercel Dashboard → Storage → Blob, then copy the token.
# Leave empty locally to store files under public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=""
