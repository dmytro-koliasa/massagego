# Database — PostgreSQL (required for Vercel; use local Docker or Neon/Supabase)
# Local Docker (see docker-compose.yml):
DATABASE_URL="postgresql://massage:massage@localhost:5432/massage?schema=public"
# Neon / Vercel Postgres example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Pre-release constraint check (P-1): npm run db:verify-constraints — see docs/ops/pre-release.md

# Auth.js — generate with: npx auth secret
AUTH_SECRET="dev-secret-change-me-in-production"

# App URL (used by Auth.js for callbacks)
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URIs (exact match required):
#   http://localhost:3000/api/auth/masseur/callback/google
#   http://localhost:3000/api/auth/client/callback/google
#   https://YOUR_DOMAIN/api/auth/masseur/callback/google
#   https://YOUR_DOMAIN/api/auth/client/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel Blob — required on Vercel so photo uploads persist.
# Create in Vercel Dashboard → Storage → Blob, then copy the token.
# Leave empty locally to store files under public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=""

# Email (P-3 / BR-009). Default `log` prints to the server console.
# Local real sends (free Resend tier, no custom domain): see docs/ops/email-local.md
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...
#   EMAIL_FROM=MassageGo <onboarding@resend.dev>
#   Recipients must be your Resend account email until you verify a domain.
# Production (deferred): own domain + verified EMAIL_FROM on the host of your choice.
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="MassageGo <onboarding@resend.dev>"

# Local cron scripts (with `npm run dev` running):
#   npm run cron:notifications  → GET /api/cron/notifications (see docs/ops/email-local.md)
#   npm run cron:cleanup        → GET /api/cron/cleanup (retention; see docs/ops/pre-release.md)
# Production host cron uses the same paths with Authorization: Bearer CRON_SECRET.
# Required in production; optional locally (cron is open when unset outside production).
CRON_SECRET=""

# Telegram bot (PR 13 / BR-009 + BR-023). Create via @BotFather.
# Webhook URL: https://YOUR_DOMAIN/api/telegram/webhook
# Set webhook with secret_token matching TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Admin portal bootstrap (PR 15 / BR-021). Creates the first admin User on
# /admin/login when no admin exists yet. Leave empty after the first admin exists.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Test suite (see docs/testing.md). Dedicated DB created by docker init or
# `npm run db:test:prepare`. Never point this at the development `massage` DB.
TEST_DATABASE_URL="postgresql://massage:massage@localhost:5432/massage_test?schema=public"
