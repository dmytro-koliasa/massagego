# Database
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="dev-secret-change-me-in-production"

# App URL (used by Auth.js for callbacks)
AUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URIs (exact match required):
#   http://localhost:3000/api/auth/masseur/callback/google
#   http://localhost:3000/api/auth/client/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
