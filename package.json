{
  "name": "massage-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "typecheck": "prisma generate && next typegen && tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "node scripts/db-migrate-test.mjs",
    "db:test:prepare": "node scripts/db-test-prepare.mjs",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d db",
    "db:verify-constraints": "node scripts/db-verify-constraints.mjs",
    "db:seed-masseurs": "tsx scripts/seed-test-masseurs.ts",
    "db:backfill-slugs": "tsx scripts/backfill-masseur-slugs.ts",
    "cron:notifications": "node scripts/cron-notifications.mjs",
    "cron:notifications:loop": "node scripts/cron-notifications-loop.mjs",
    "cron:cleanup": "node scripts/cron-cleanup.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "geo-tz": "^8.1.11",
    "libphonenumber-js": "^1.13.13",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-phone-number-input": "^3.4.18",
    "react-photo-album": "^3.6.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "21.0.4",
    "knip": "^6.46.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
